{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "skipLibCheck": true,
    "paths": {
      "@screens": ["./src/screens"],
      "@screens/*": ["./src/screens/*"],
      "@components": ["./src/components"],
      "@components/*": ["./src/components/*"],
      "@constants": ["./src/constants"],
      "@constants/*": ["./src/constants/*"],
      "@services": ["./src/services"],
      "@services/*": ["./src/services/*"],
      "@stores": ["./src/stores"],
      "@stores/*": ["./src/stores/*"],
      "@hooks": ["./src/hooks"],
      "@hooks/*": ["./src/hooks/*"],
      "@navigation": ["./src/navigation"],
      "@navigation/*": ["./src/navigation/*"]
    }
  },
  "include": [
    "src",
    "App.tsx",
    "index.js"
  ],
  "exclude": [
    "node_modules",
    "**/Pods/**",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}